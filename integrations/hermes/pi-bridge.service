[Unit]
Description=Pi bridge - task runner, signed push callbacks, watchdog, heartbeat
Documentation=https://github.com/wicahma/pi-bridge/blob/main/docs/PROTOCOL.md
After=network.target

# Do not let a crash loop take the machine down.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/state/pi-bridge
ExecStart=/usr/bin/python3 %h/.local/share/pi-bridge/pi_bridge.py serve

# pi (and its node runtime) live under ~/.local/bin, which systemd does not
# inherit from the login shell - without this the HTTP /submit route dies
# with FileNotFoundError: 'pi' while CLI submits still work.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PI_BIN=%h/.local/bin/pi

# --- engine ---
Environment=PI_BRIDGE_STATE_DIR=%h/.local/state/pi-bridge
Environment=PI_BRIDGE_PORT=8799
Environment=PI_BRIDGE_WATCHDOG_INTERVAL=30
Environment=PI_BRIDGE_HEARTBEAT_INTERVAL=60

# --- push notifications (optional; unset = silent, no outbound calls) ---
Environment=PI_BRIDGE_NOTIFY_URL=http://127.0.0.1:8644/webhooks/pi-done
Environment=PI_BRIDGE_NOTIFY_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
Environment=PI_BRIDGE_HEARTBEAT_URL=http://127.0.0.1:8644/webhooks/pi-status

# --- orchestrator integration (optional; unset = no model inheritance) ---
Environment=PI_BRIDGE_ORCHESTRATOR_DB=%h/.hermes/state.db
Environment=PI_BRIDGE_ORCHESTRATOR_CONFIG=%h/.hermes/config.yaml

# Restart on any failure: this process owns task state, so it must come back on
# its own. reconcile() runs on every start and re-settles tasks whose callbacks
# were lost while it was down, so a restart is safe.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
